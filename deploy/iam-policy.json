{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StateObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::RSI_STATE_BUCKET", "arn:aws:s3:::RSI_STATE_BUCKET/rsi/*"]
    },
    {
      "Sid": "HeadsOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/RSI_STATE_HEADS"
    }
  ]
}

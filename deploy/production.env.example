# Set RSI_STATE_ENV=production only when all mandatory controls are configured.
RSI_STATE_ENV=production
RSI_STATE_ADDR=:8443
# Identity is the verified mTLS SPIFFE URI or client-certificate common name.
# Roles are reader, evolver, verifier, selector. Do not use bearer tokens.
RSI_STATE_ROLE_MAP={"spiffe://example/rsi/evolver":"evolver","spiffe://example/rsi/verifier":"verifier","spiffe://example/rsi/selector":"selector"}
RSI_STATE_TLS_CERT_FILE=/run/secrets/server.crt
RSI_STATE_TLS_KEY_FILE=/run/secrets/server.key
RSI_STATE_TLS_CLIENT_CA_FILE=/run/secrets/workload-ca.crt
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector.observability.svc:4317
OTEL_SERVICE_NAME=rsi-state
# Optional; readiness verifies it when configured.
RSI_STATE_CACHE_ROOT=/var/lib/rsi-state/cache
